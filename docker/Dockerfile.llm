# LLM — Qwen3-VL on the NPU behind an OpenAI-compatible endpoint.
#
# Deliberately NOT built on the ROS base. Nothing here needs ROS: the agent
# talks to this over HTTP, which is precisely what makes the model swappable.
# Point LLM_BASE_URL at a bigger model on another machine, or at a cloud API,
# and nothing above this layer changes.
#
# THE VERSION CHAIN — three things must agree, and only one is in this image:
#
#     .rkllm file  <->  librkllmrt.so (here)  <->  rknpu driver (host, v0.9.8)
#
# Most published .rkllm conversions target older RKLLM runtimes, so the pin
# below is deliberately NOT the newest release. Check what your chosen model
# was converted with (the version is usually in the filename) and match it.
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# release-v1.2.1 rather than v1.3.0: 1.3.0 adds Qwen3.5 support, but no
# pre-converted Qwen3.5 .rkllm appears to be published, and with no x86 machine
# you can only run what someone else converted. Bump this together with the
# model in models/manifest.yaml, never separately.
ARG RKLLM_TAG=release-v1.2.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/lib/librkllmrt.so \
      "https://github.com/airockchip/rknn-llm/raw/${RKLLM_TAG}/rkllm-runtime/Linux/librkllm_api/aarch64/librkllmrt.so" \
    && ldconfig \
    && echo "${RKLLM_TAG}" > /etc/kobold-rkllm-version

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pydantic

ENV RKLLM_LIB=/usr/lib/librkllmrt.so \
    MODEL_PATH=/models/qwen3-vl-2b \
    MAX_CONTEXT=4096 \
    PORT=8080

EXPOSE 8080

# NOTE: the server that binds librkllmrt to an OpenAI-compatible API is Phase 6.
# This image pins and ships the runtime so the version chain can be verified on
# hardware first — that is the part most likely to go wrong, and it is cheap to
# check before writing anything on top of it.
CMD ["bash", "-lc", "echo \"kobold-llm: librkllmrt $(cat /etc/kobold-rkllm-version) ready, server lands in Phase 6\" && sleep infinity"]
