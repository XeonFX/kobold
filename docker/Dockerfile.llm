# Qwen3.5-2B on RK3588 via RKLLM, exposed as an OpenAI-compatible API.
#
# Version chain (validated together on the Rock 5B):
#   Qwen3.5 RKLLM 1.3.0 artifact <-> librkllmrt 1.3.0 <-> RKNPU driver 0.9.8
#
# The inference server is native C++. Python is not present in the runtime
# image and no generated token crosses a process boundary.
FROM debian:bookworm-slim AS build

ARG RKLLM_REF=878f9361fd3afa7e167b7079918918f78d2c1c2a
ARG RKLLM_RT_SHA256=6a9e4fc5324c68921c3a900340361e107af7599fe34dc8fa7759b2c5ae22a6e6
ARG RKLLM_HEADER_SHA256=80596a578f7f8e70df6eda1c2cbead3bfced14623a190258f2bd009a3d1f72cf

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl g++ libcpp-httplib-dev nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/lib/librkllmrt.so \
      "https://raw.githubusercontent.com/airockchip/rknn-llm/${RKLLM_REF}/rkllm-runtime/Linux/librkllm_api/aarch64/librkllmrt.so" \
    && echo "${RKLLM_RT_SHA256}  /usr/local/lib/librkllmrt.so" | sha256sum -c - \
    && curl -fsSL -o /usr/local/include/rkllm.h \
      "https://raw.githubusercontent.com/airockchip/rknn-llm/${RKLLM_REF}/rkllm-runtime/Linux/librkllm_api/include/rkllm.h" \
    && echo "${RKLLM_HEADER_SHA256}  /usr/local/include/rkllm.h" | sha256sum -c -

COPY llm/server.cpp /src/server.cpp
RUN g++ -std=c++17 -O3 -DNDEBUG -Wall -Wextra -Wpedantic \
      -I/usr/local/include /src/server.cpp \
      -L/usr/local/lib -Wl,-rpath,/usr/lib -lrkllmrt -lcpp-httplib -pthread \
      -o /usr/local/bin/kobold-llm-server \
    && strip /usr/local/bin/kobold-llm-server

FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libcpp-httplib0.11 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/lib/librkllmrt.so /usr/lib/librkllmrt.so
COPY --from=build /usr/local/bin/kobold-llm-server /usr/local/bin/kobold-llm-server
RUN ldconfig \
    && echo "release-v1.3.0 878f9361fd3afa7e167b7079918918f78d2c1c2a" \
       > /etc/kobold-rkllm-version

ENV MODEL_PATH=/models/qwen3.5-2b_w8a8_rk3588.rkllm \
    MODEL_NAME=qwen3.5-2b-rk3588 \
    MAX_CONTEXT=4096 \
    MAX_NEW_TOKENS=512 \
    PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -fsS http://localhost:8080/healthz || exit 1

CMD ["/usr/local/bin/kobold-llm-server"]
