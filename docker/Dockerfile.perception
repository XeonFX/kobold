# Perception — YOLO detection, SigLIP embeddings, monocular depth, on the NPU.
#
# Extends the ROS base because perception publishes into the ROS graph, and adds
# the RKNN runtime on top.
#
# THE VERSION CHAIN
# -----------------
# librknnrt.so in this image must be compatible with the rknpu kernel driver on
# the HOST. This is the one place containerisation does not give independence —
# you cannot pin your way out of a kernel interface. Verified on the robot:
#
#     rknpu driver : v0.9.8    (the newest that exists; RKLLM needs >= 0.9.6)
#     librknnrt    : 2.3.0     (matches the host's own /usr/lib copy)
#
# entrypoint.sh prints both at startup so a mismatch is the first line in the
# log rather than an inference failure that looks like model corruption.
# FROM the upstream ROS image, not from kobold-ros: the CI matrix builds all
# services in PARALLEL, so depending on a sibling image is a race. Both start
# from the same upstream layers, so the registry cache still shares most of it.
FROM ros:jazzy-ros-base AS base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

ARG RKNN_VERSION=2.3.0

# OpenCV in this base is built WITH GStreamer but WITHOUT the V4L2 backend, and
# /dev/video11 is a multiplanar device that the V4L2 backend could not open
# anyway. So GStreamer is the only capture path, and it needs its plugins
# present -- linking libgstreamer is not enough. Without plugins-good you get
# `no element "v4l2src"` at runtime, long after the image builds cleanly.
#   plugins-base : videoconvert, videoscale
#   plugins-good : v4l2src
#   tools        : gst-launch-1.0, gst-inspect-1.0, for debugging on the robot
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      python3-pip \
      python3-opencv \
      python3-numpy \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-tools \
      v4l-utils \
      ros-jazzy-cv-bridge \
      ros-jazzy-image-transport \
      ros-jazzy-vision-msgs \
    && rm -rf /var/lib/apt/lists/*

# Pinned by tag, not `main` — a runtime that silently moves is exactly the
# failure this whole pipeline exists to prevent.
RUN curl -fsSL -o /usr/lib/librknnrt.so \
      "https://github.com/airockchip/rknn-toolkit2/raw/v${RKNN_VERSION}/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so" \
    && ldconfig \
    && echo "${RKNN_VERSION}" > /etc/kobold-rknn-version

# rknn-toolkit-lite2 is the INFERENCE half. The conversion toolkit
# (rknn-toolkit2) is x86_64-only and deliberately absent: models are converted
# elsewhere and arrive as artifacts. See models/manifest.yaml.
#
# NOT on PyPI -- it ships as per-Python-version wheels in the airockchip repo,
# so `pip install rknn-toolkit-lite2` can never resolve. An earlier revision of
# this file did exactly that behind a `|| echo WARN` fallback, which shipped an
# image with no Python API at all and printed a confidently wrong reason.
#
# The cp tag is derived from the interpreter rather than hardcoded, so if the
# ROS base moves to a Python with no published wheel the build FAILS LOUDLY
# here instead of silently omitting the package.
RUN PYTAG="cp$(python3 -c 'import sys; print(f"{sys.version_info.major}{sys.version_info.minor}")')" \
    && WHEEL="rknn_toolkit_lite2-${RKNN_VERSION}-${PYTAG}-${PYTAG}-manylinux_2_17_aarch64.manylinux2014_aarch64.whl" \
    && echo "installing ${WHEEL}" \
    && curl -fsSL -o "/tmp/${WHEEL}" \
         "https://github.com/airockchip/rknn-toolkit2/raw/v${RKNN_VERSION}/rknn-toolkit-lite2/packages/${WHEEL}" \
    && pip3 install --no-cache-dir --break-system-packages "/tmp/${WHEEL}" \
    && rm -f "/tmp/${WHEEL}" \
    && python3 -c "from rknnlite.api import RKNNLite; print('rknnlite import OK')"


# --------------------------------------------------------------------- RGA --
# RK3588's 2D accelerator. Colour conversion and scaling are what it exists for,
# and doing them on the CPU instead is measurably expensive — cv2's NV12->BGR
# plus letterbox costs 20.3 ms of CPU per frame against RGA's 0.69 ms, because
# OpenCV reaches that speed by using every core it can find. On a robot those
# cores belong to ASR and the LLM.
#
# Not in Ubuntu's apt (it comes from Rockchip), so pinned from upstream by tag
# exactly like librknnrt. The version chain is looser here than for the NPU —
# RGA is a stable 2D blitter, not a kernel-coupled inference runtime — but pin
# it anyway so builds are reproducible.
ARG LIBRGA_TAG=v1.10.0
RUN curl -fsSL -o /usr/lib/librga.so \
      "https://github.com/airockchip/librga/raw/${LIBRGA_TAG}/libs/Linux/gcc-aarch64/librga.so" \
    && mkdir -p /usr/include/rga \
    && for h in im2d.h im2d_type.h im2d_buffer.h im2d_common.h im2d_single.h \
                im2d_task.h im2d_expand.h im2d_mpi.h im2d_version.h rga.h \
                drmrga.h RgaUtils.h RgaApi.h; do \
         curl -fsSL -o "/usr/include/rga/$h" \
           "https://github.com/airockchip/librga/raw/${LIBRGA_TAG}/include/$h"; \
       done \
    && ldconfig \
    && echo "${LIBRGA_TAG}" > /etc/kobold-librga-version

# Small C shim over im2d. The API passes rga_buffer_t BY VALUE, and replicating
# that struct in ctypes would mean keeping a large layout in sync with the
# header — one wrong field gives silent corruption rather than an error. Two
# pointer-and-int functions have no such failure mode.
COPY ros2_ws/src/kobold_perception/rga/rga_shim.c /tmp/rga_shim.c

# --------------------------------------------------------------------- MPP --
# Hardware video encode. The vendor GStreamer plugin manages 0.9 fps for work
# MPP itself does at 250-300 (stalls in poll_packet_locked), its upstream repo
# is a 404, and Radxa ships no newer build — so talk to MPP directly.
#
# Measured, 1280x960, 60 distinct real frames, at the 12 fps camera rate:
#     MJPEG  3.0% of a core, 5.61 Mbit/s
#     H.264  1.5% of a core, 0.69 Mbit/s
#     (software equivalents: jpegenc ~6.8%, x264enc 70.4%)
# Pinned by URL and sha256 from Radxa's repo, not by adding the repo itself —
# this image is Ubuntu 24.04 and that is a Debian 12 archive. Same approach as
# librknnrt and librga: fetch a known artifact, verify it, move on.
#
# MPP is kernel-coupled (it talks to /dev/mpp_service), so this version must
# stay compatible with the host driver, exactly like librknnrt. 1.5.0 is what
# the robot runs.
ARG LIBMPP_VER=1.5.0-1
ARG LIBMPP_SHA256=6a00cd23eb8ac59bc0e338ad0f88d61757a16c95d183b2983c86535e2a0fd378
ARG LIBMPP_DEV_SHA256=f0edadc4a295cbf7e08fd9f46bea5954d4a129e0efe309ebb3e7f1f267c861c0
ARG LIBMPP_BASE=https://radxa-repo.github.io/rk3588-bookworm/pool/main/m/mpp
RUN curl -fsSL -o /tmp/mpp.deb "${LIBMPP_BASE}/librockchip-mpp1_${LIBMPP_VER}_arm64.deb" \
    && echo "${LIBMPP_SHA256}  /tmp/mpp.deb" | sha256sum -c - \
    && curl -fsSL -o /tmp/mpp-dev.deb "${LIBMPP_BASE}/librockchip-mpp-dev_${LIBMPP_VER}_arm64.deb" \
    && echo "${LIBMPP_DEV_SHA256}  /tmp/mpp-dev.deb" | sha256sum -c - \
    && dpkg -x /tmp/mpp.deb /tmp/mppx && dpkg -x /tmp/mpp-dev.deb /tmp/mppx \
    && cp -a /tmp/mppx/usr/lib/aarch64-linux-gnu/librockchip_mpp.so* /usr/lib/aarch64-linux-gnu/ \
    && cp -a /tmp/mppx/usr/include/rockchip /usr/include/ \
    && rm -rf /tmp/mpp.deb /tmp/mpp-dev.deb /tmp/mppx \
    && ldconfig \
    && echo "${LIBMPP_VER}" > /etc/kobold-libmpp-version

COPY ros2_ws/src/kobold_perception/rga/mpp_enc_shim.c /tmp/mpp_enc_shim.c

# Both shims built in one layer so the toolchain is installed and removed once.
# NOTE: the toolchain is installed and LEFT INSTALLED. An earlier revision
# purged it afterwards, which looked tidy and was wrong: `apt-get purge
# libc6-dev && apt-get autoremove` cascades into ros-jazzy-rosidl-* and breaks
# the ROS install. ~50 MB in a 2.4 GB image is not worth that risk.
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && gcc -O2 -fPIC -shared -o /usr/lib/libkobold_rga.so /tmp/rga_shim.c -lrga -lpthread \
    && gcc -O2 -fPIC -shared -o /usr/lib/libkobold_mppenc.so /tmp/mpp_enc_shim.c \
         -lrockchip_mpp -lpthread \
    && rm -f /tmp/rga_shim.c /tmp/mpp_enc_shim.c \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

ENV RKNN_LIB=/usr/lib/librknnrt.so \
    MODELS_DIR=/models

# ------------------------------------------------------------------ build ----
# This image previously shipped WITHOUT the ROS workspace, so
# `ros2 launch kobold_perception camera.launch.py` -- which compose.yaml has
# always asked for -- could only ever have failed with "package not found".
FROM base AS build
WORKDIR /ws
COPY ros2_ws/src ./src
RUN . /opt/ros/jazzy/setup.bash \
    && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# ---------------------------------------------------------------- runtime ----
# Multi-stage: colcon and the compilers stay behind.
FROM base AS runtime
COPY --from=build /ws/install /ws/install

# Prints the NPU version chain at startup so a driver/runtime mismatch is the
# first line in the log rather than an inference failure that looks like model
# corruption.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV ROS_WS=/ws
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "kobold_perception", "perception.launch.py"]
